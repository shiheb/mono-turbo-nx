{
  "name": "@mono-turbo-nx/frontend",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/next:build",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "root": "frontend",
          "outputPath": "dist/frontend"
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "serve": {
        "executor": "@nx/next:server",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@mono-turbo-nx/frontend:build",
          "dev": true
        },
        "configurations": {
          "development": {
            "buildTarget": "@mono-turbo-nx/frontend:build:development",
            "dev": true
          },
          "production": {
            "buildTarget": "@mono-turbo-nx/frontend:build:production",
            "dev": false
          }
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/frontend"
        ],
        "options": {
          "jestConfig": "frontend/jest.config.ts",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@iconify/react": "^5.0.2",
    "@types/aos": "^3.0.7",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "glightbox": "^3.3.0",
    "gumshoejs": "^5.1.2",
    "next": "15.5.3",
    "preline": "^2.5.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-text-typist": "^1.1.8",
    "swiper": "^11.1.14",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "globals": "^16.4.0"
  }
}